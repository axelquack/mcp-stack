# Setting names only. Copy this file to .env and fill values locally.
# Do not commit .env. Leave every value empty here.

# Address the proxy binds on.
BIND_ADDRESS=

# Host port for the proxy.
GATEWAY_PORT=

# Port the proxy process listens on inside its container.
PROXY_INTERNAL_PORT=

# Port the MCP server processes listen on inside their containers.
INTERNAL_PORT=

# Host port published for the Context7 container.
CONTEXT7_EXT_PORT=

# Port the Context7 healthcheck calls inside that container.
CONTEXT7_HEALTH_PORT=

# Context7 API key. Real value only in .env.
CONTEXT7_API_KEY=

# Host port published for the SearXNG MCP container.
SEARXNG_EXT_PORT=

# Base URL of the upstream SearXNG instance.
SEARXNG_URL=
